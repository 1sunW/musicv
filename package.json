{
  "name": "x8music",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch index.ts",
    "postinstall": "curl -L --fail --silent --show-error https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o services/soundcloud-backend/yt-dlp && chmod +x services/soundcloud-backend/yt-dlp || true",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "express": "^4.19.2",
    "fastify": "^5.8.5",
    "playwright": "1.61.1",
    "youtube-dl-exec": "^3.1.6",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/yt-search": "^2.10.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
